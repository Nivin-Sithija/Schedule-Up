{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "FollowThrough: start dependencies",
      "type": "process",
      "command": "${workspaceFolder}/node_modules/.bin/node",
      "args": ["--env-file-if-exists=.env", "--import", "tsx", "scripts/start-local.ts"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "FollowThrough: build dashboard",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "FollowThrough: prepare workspace",
      "dependsOrder": "sequence",
      "dependsOn": ["FollowThrough: start dependencies", "FollowThrough: build dashboard"],
      "problemMatcher": []
    }
  ]
}
