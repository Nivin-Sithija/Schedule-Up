# Copy to .env. Never commit real numbers or credentials.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma4:12b
OLLAMA_CONTEXT_TOKENS=4096
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_FALLBACK_MODEL=google/gemma-4-31b-it:free
APP_TIMEZONE=Asia/Colombo
PORT=3001
HOST=127.0.0.1
STORE_DRIVER=file
DATA_PATH=./data/state.json
TIGER_DATABASE_URL=
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
DURABLE_MODE=local
WHATSAPP_PROVIDER=mock
WAHA_URL=http://localhost:3000
# Legacy session identifier only; new accounts get separate ft-<account-id> sessions.
WAHA_SESSION=default
WAHA_API_KEY=
WAHA_WEBHOOK_HMAC_KEY=
SENTRY_DSN=

# Apple Silicon: devlikeapro/waha:noweb-arm-2026.9.2
WAHA_IMAGE=devlikeapro/waha:noweb-2026.9.2
# Optional trusted Tiger certificate bundle (keeps certificate verification enabled)
TIGER_CA_PATH=
# Hosted alternative: base64-encode the trusted PEM CA; takes precedence over CA_PATH.
TIGER_CA_BASE64=
# Docker prewarms this path; leave empty for the local library default cache.
EMBEDDING_CACHE_PATH=

# Personal Telegram adapter (application credentials from https://my.telegram.org/apps).
# Users link their own accounts through QR; these are NOT bot tokens.
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
# Required for hosted Telegram; generate with: openssl rand -hex 32
# Local development generates a private persistent key under data/connections/.
SESSION_ENCRYPTION_KEY=
